rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for the hardcoded superadmin
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == "rohit.no18@gmail.com" ||
        request.auth.token.admin == true
      );
    }

    // App Configuration & Toggles
    match /app_config/{docId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // User Lookup (uniqueness enforcement by email/phone)
    // get-only: existence checks work, but the collection cannot be listed
    // (prevents email/phone enumeration by authenticated users)
    match /user_lookup/{key} {
      allow get: if request.auth != null;
      allow list: if isSuperAdmin();
      allow create: if (request.auth != null && request.resource.data.uid == request.auth.uid) || isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // Audit Logs (Telemetry Engine)
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSuperAdmin(); // Logs are immutable to the user
    }

    // Users collection and sub-collections
    // Owners may manage their profile but can never grant themselves
    // privileged fields (role, tier) — those are set only by admins/Cloud Functions
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isSuperAdmin();
      allow create: if isSuperAdmin() || (
        request.auth != null && request.auth.uid == userId &&
        (!("role" in request.resource.data) || request.resource.data.role == "patient") &&
        (!("tier" in request.resource.data) || request.resource.data.tier == "free")
      );
      allow update: if isSuperAdmin() || (
        request.auth != null && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role", "tier"])
      );
      allow delete: if (request.auth != null && request.auth.uid == userId) || isSuperAdmin();
      match /{allPaths=**} {
        allow read, write: if (request.auth != null && request.auth.uid == userId) || isSuperAdmin();
      }
    }

    // Patients
    match /patients/{patientId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isSuperAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isSuperAdmin();
    }

    // Folders
    match /folders/{folderId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isSuperAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isSuperAdmin();
    }

    // Documents
    match /documents/{docId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isSuperAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isSuperAdmin();
    }

    // Appointments
    match /appointments/{apptId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isSuperAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isSuperAdmin();
    }

    // Life Events
    match /life_events/{eventId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isSuperAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isSuperAdmin();
    }

    // Doctors — only admins can write, patients can read their assigned doctor
    match /doctors/{doctorId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Structured health data extracted from documents (metrics, medicines,
    // follow-ups). Owner-scoped like every other medical collection.
    match /health_metrics/{metricId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isSuperAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isSuperAdmin();
    }

    match /medications/{medId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isSuperAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isSuperAdmin();
    }

    match /follow_ups/{followUpId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isSuperAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isSuperAdmin();
    }

    // Health insights generated by the proactive watch agent (Admin SDK writes)
    match /health_insights/{insightId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isSuperAdmin();
      allow create: if isSuperAdmin();
    }

    // Vitals
    match /vitals/{vitalId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isSuperAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isSuperAdmin();
    }

    // Reminders
    match /reminders/{reminderId} {
      allow read, update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isSuperAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isSuperAdmin();
    }

    // Emergency Info — only writable by owner/admin, read via secure Cloud Function
    match /emergency_info/{patientId} {
      allow read: if isSuperAdmin();
      allow update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isSuperAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isSuperAdmin();
    }

    // User Usage — per-user daily AI usage tracking (written by Cloud Function admin SDK)
    match /user_usage/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isSuperAdmin();
      allow write: if isSuperAdmin(); // Written only by Cloud Functions via Admin SDK
      match /daily/{day} {
        allow read: if (request.auth != null && request.auth.uid == userId) || isSuperAdmin();
        allow write: if isSuperAdmin();
      }
      match /monthly/{month} {
        allow read: if (request.auth != null && request.auth.uid == userId) || isSuperAdmin();
        allow write: if isSuperAdmin(); // Written only by Cloud Functions via Admin SDK
      }
    }

    // App Stats — global analytics counters, written only by Cloud Functions
    // (Admin SDK bypasses rules), readable by admins for the analytics dashboard
    match /app_stats/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
      match /{allPaths=**} {
        allow read: if isSuperAdmin();
        allow write: if false;
      }
    }

    // Support Tickets — user-created, threaded conversation with admins.
    // Owners see only their own tickets; admins see all.
    match /support_tickets/{ticketId} {
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || isSuperAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Owner may update thread metadata but never reassign the ticket
      allow update: if isSuperAdmin() || (
        request.auth != null && resource.data.userId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["userId"])
      );
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if isSuperAdmin() || (
          request.auth != null &&
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid
        );
        allow create: if isSuperAdmin() || (
          request.auth != null &&
          request.resource.data.sender == "user" &&
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid
        );
        allow update, delete: if isSuperAdmin();
      }
    }

    // Debug Logs — authenticated writes only, read by superadmin
    match /debug_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if isSuperAdmin();
    }

    // Shared Links — public read only while unexpired (expiry enforced server-side,
    // not just in the client), owner write
    match /shared_links/{shareId} {
      allow read: if resource.data.expiresAt == null || request.time < resource.data.expiresAt;
      allow update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isSuperAdmin();
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isSuperAdmin();
    }
  }
}
